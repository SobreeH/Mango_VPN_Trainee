generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum RoleName {
  ADMIN
  STAFF
  CLIENT
}

enum DeviceStatus {
  ACTIVE
  REVOKED
  PENDING
}

enum SessionStatus {
  ACTIVE
  DISCONNECTED
  EXPIRED
}

enum PolicyAction {
  ALLOW
  DENY
}

enum PolicyProtocol {
  ANY
  TCP
  UDP
  ICMP
}

model Role {
  id          String      @id @default(uuid()) @db.Uuid
  name        RoleName    @unique
  description String?
  createdAt   DateTime    @default(now()) @map("created_at")
  updatedAt   DateTime    @updatedAt @map("updated_at")
  users       User[]
  policies    VpnPolicy[]

  @@map("roles")
}

model User {
  id                  String          @id @default(uuid()) @db.Uuid
  username            String          @unique
  email               String          @unique
  passwordHash        String          @map("password_hash")
  roleId              String          @map("role_id") @db.Uuid
  role                Role            @relation(fields: [roleId], references: [id])
  isActive            Boolean         @default(true) @map("is_active")
  tokenVersion        Int             @default(0) @map("token_version")
  totpSecretEncrypted String?         @map("totp_secret_encrypted")
  totpEnabled         Boolean         @default(false) @map("totp_enabled")
  createdAt           DateTime        @default(now()) @map("created_at")
  updatedAt           DateTime        @updatedAt @map("updated_at")
  devices             Device[]
  peers               VpnPeer[]
  sessions            VpnSession[]
  refreshTokens       RefreshToken[]
  connectTickets      ConnectTicket[]
  auditLogs           AuditLog[]      @relation("AuditActor")

  @@index([roleId])
  @@map("users")
}

model Device {
  id          String       @id @default(uuid()) @db.Uuid
  userId      String       @map("user_id") @db.Uuid
  user        User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  hostname    String
  fingerprint String       @unique
  status      DeviceStatus @default(ACTIVE)
  lastSeenAt  DateTime?    @map("last_seen_at")
  createdAt   DateTime     @default(now()) @map("created_at")
  updatedAt   DateTime     @updatedAt @map("updated_at")
  peers       VpnPeer[]
  sessions    VpnSession[]

  @@index([userId])
  @@map("devices")
}

model VpnPeer {
  id         String       @id @default(uuid()) @db.Uuid
  userId     String       @map("user_id") @db.Uuid
  user       User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  deviceId   String       @map("device_id") @db.Uuid
  device     Device       @relation(fields: [deviceId], references: [id], onDelete: Cascade)
  publicKey  String       @unique @map("public_key")
  assignedIp String       @unique @map("assigned_ip")
  isActive   Boolean      @default(true) @map("is_active")
  createdAt  DateTime     @default(now()) @map("created_at")
  updatedAt  DateTime     @updatedAt @map("updated_at")
  sessions   VpnSession[]

  @@index([userId])
  @@index([deviceId])
  @@map("vpn_peers")
}

model VpnSession {
  id             String        @id @default(uuid()) @db.Uuid
  userId         String        @map("user_id") @db.Uuid
  user           User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  deviceId       String        @map("device_id") @db.Uuid
  device         Device        @relation(fields: [deviceId], references: [id], onDelete: Cascade)
  peerId         String        @map("peer_id") @db.Uuid
  peer           VpnPeer       @relation(fields: [peerId], references: [id], onDelete: Cascade)
  assignedIp     String        @map("assigned_ip")
  status         SessionStatus @default(ACTIVE)
  connectedAt    DateTime      @default(now()) @map("connected_at")
  disconnectedAt DateTime?     @map("disconnected_at")

  @@index([userId])
  @@index([status])
  @@map("vpn_sessions")
}

model VpnPolicy {
  id         String         @id @default(uuid()) @db.Uuid
  roleId     String         @map("role_id") @db.Uuid
  role       Role           @relation(fields: [roleId], references: [id], onDelete: Cascade)
  name       String
  targetCidr String         @map("target_cidr")
  protocol   PolicyProtocol @default(ANY)
  portRange  String?        @map("port_range")
  action     PolicyAction
  priority   Int            @default(100)
  enabled    Boolean        @default(true)
  createdAt  DateTime       @default(now()) @map("created_at")
  updatedAt  DateTime       @updatedAt @map("updated_at")

  @@index([roleId, priority])
  @@map("vpn_policies")
}

model AuditLog {
  id          String   @id @default(uuid()) @db.Uuid
  actorUserId String?  @map("actor_user_id") @db.Uuid
  actor       User?    @relation("AuditActor", fields: [actorUserId], references: [id], onDelete: SetNull)
  action      String
  targetType  String   @map("target_type")
  targetId    String?  @map("target_id")
  ipAddress   String?  @map("ip_address")
  metadata    Json?
  createdAt   DateTime @default(now()) @map("created_at")

  @@index([actorUserId])
  @@index([createdAt])
  @@map("audit_logs")
}

model AgentVersion {
  id             String   @id @default(uuid()) @db.Uuid
  version        String
  platform       String
  checksumSha256 String   @map("checksum_sha256")
  downloadUrl    String   @map("download_url")
  isMandatory    Boolean  @default(false) @map("is_mandatory")
  releasedAt     DateTime @default(now()) @map("released_at")

  @@unique([version, platform])
  @@map("agent_versions")
}

model RefreshToken {
  id                String    @id @default(uuid()) @db.Uuid
  userId            String    @map("user_id") @db.Uuid
  user              User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  tokenHash         String    @unique @map("token_hash")
  familyId          String    @map("family_id") @db.Uuid
  expiresAt         DateTime  @map("expires_at")
  revokedAt         DateTime? @map("revoked_at")
  replacedByTokenId String?   @map("replaced_by_token_id") @db.Uuid
  createdAt         DateTime  @default(now()) @map("created_at")

  @@index([userId])
  @@index([familyId])
  @@map("refresh_tokens")
}

model ConnectTicket {
  id         String    @id @default(uuid()) @db.Uuid
  userId     String    @map("user_id") @db.Uuid
  user       User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  ticketHash String    @unique @map("ticket_hash")
  expiresAt  DateTime  @map("expires_at")
  redeemedAt DateTime? @map("redeemed_at")
  createdAt  DateTime  @default(now()) @map("created_at")

  @@index([userId])
  @@index([expiresAt])
  @@map("connect_tickets")
}

model AuthRateLimit {
  id            String    @id @default(uuid()) @db.Uuid
  key           String    @unique
  attempts      Int       @default(0)
  windowStartAt DateTime  @default(now()) @map("window_start_at")
  lockedUntil   DateTime? @map("locked_until")
  updatedAt     DateTime  @updatedAt @map("updated_at")

  @@map("auth_rate_limits")
}
