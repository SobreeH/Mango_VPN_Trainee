// MANGO VPN - Prisma ORM Schema
// Zero-Trust Role-Based WireGuard VPN Management System

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ==========================================
// 1. Roles (Permission Tiers)
// ==========================================
model Role {
  id          String   @id @default(uuid()) @db.Uuid
  name        String   @unique @db.VarChar(50) // e.g. ADMIN, STAFF, CLIENT
  description String?  @db.Text
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  users    User[]
  policies VpnPolicy[]

  @@map("roles")
}

// ==========================================
// 2. Users (Core Identity)
// ==========================================
model User {
  id           String   @id @default(uuid()) @db.Uuid
  username     String   @unique @db.VarChar(100)
  passwordHash String   @map("password_hash") @db.VarChar(255)
  phoneNumber  String   @map("phone_number") @db.VarChar(30)
  roleId       String   @map("role_id") @db.Uuid
  isActive     Boolean  @default(true) @map("is_active")
  createdAt    DateTime @default(now()) @map("created_at")
  updatedAt    DateTime @updatedAt @map("updated_at")

  role      Role       @relation(fields: [roleId], references: [id], onDelete: Restrict)
  devices   Device[]
  vpnPeers  VpnPeer[]
  auditLogs AuditLog[]

  @@index([roleId])
  @@index([username])
  @@map("users")
}

// ==========================================
// 3. Devices (Registered Hardware Endpoints)
// ==========================================
model Device {
  id         String   @id @default(uuid()) @db.Uuid
  userId     String   @map("user_id") @db.Uuid
  deviceName String   @map("device_name") @db.VarChar(150)
  osInfo     String   @map("os_info") @db.VarChar(150)
  macAddress String?  @map("mac_address") @db.VarChar(50)
  lastSeen   DateTime @default(now()) @map("last_seen")
  createdAt  DateTime @default(now()) @map("created_at")
  updatedAt  DateTime @updatedAt @map("updated_at")

  user     User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  vpnPeers VpnPeer[]

  @@index([userId])
  @@index([macAddress])
  @@map("devices")
}

// ==========================================
// 4. VPN Peers (WireGuard Peer Mappings)
// ==========================================
model VpnPeer {
  id         String   @id @default(uuid()) @db.Uuid
  userId     String   @map("user_id") @db.Uuid
  deviceId   String?  @map("device_id") @db.Uuid
  publicKey  String   @unique @map("public_key") @db.VarChar(64) // Base64 Curve25519 key (44 chars)
  assignedIp String   @unique @map("assigned_ip") @db.VarChar(45) // e.g. 10.13.13.10/32 or IPv6
  isEnabled  Boolean  @default(true) @map("is_enabled")
  createdAt  DateTime @default(now()) @map("created_at")
  updatedAt  DateTime @updatedAt @map("updated_at")

  user     User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  device   Device?      @relation(fields: [deviceId], references: [id], onDelete: SetNull)
  sessions VpnSession[]

  @@index([userId])
  @@index([assignedIp])
  @@map("vpn_peers")
}

// ==========================================
// 5. VPN Sessions (Connection History & Telemetry)
// ==========================================
model VpnSession {
  id             String    @id @default(uuid()) @db.Uuid
  peerId         String    @map("peer_id") @db.Uuid
  connectedAt    DateTime  @default(now()) @map("connected_at")
  disconnectedAt DateTime? @map("disconnected_at")
  clientPublicIp String    @map("client_public_ip") @db.VarChar(45)
  bytesRx        BigInt    @default(0) @map("bytes_rx")
  bytesTx        BigInt    @default(0) @map("bytes_tx")

  peer VpnPeer @relation(fields: [peerId], references: [id], onDelete: Cascade)

  @@index([peerId])
  @@index([connectedAt])
  @@map("vpn_sessions")
}

// ==========================================
// 6. VPN Policies (Role-Based NAC Firewall Rules)
// ==========================================
model VpnPolicy {
  id              String   @id @default(uuid()) @db.Uuid
  roleId          String   @map("role_id") @db.Uuid
  destinationCidr String   @map("destination_cidr") @db.VarChar(50) // e.g. 10.10.0.0/16 or 192.168.1.100/32
  protocol        String   @default("ALL") @db.VarChar(10) // TCP, UDP, ICMP, ALL
  portRange       String   @default("ANY") @map("port_range") @db.VarChar(50) // e.g. 80,443 or 1024-65535 or ANY
  action          String   @default("ALLOW") @db.VarChar(10) // ALLOW, DENY
  createdAt       DateTime @default(now()) @map("created_at")
  updatedAt       DateTime @updatedAt @map("updated_at")

  role Role @relation(fields: [roleId], references: [id], onDelete: Cascade)

  @@index([roleId])
  @@map("vpn_policies")
}

// ==========================================
// 7. Audit Logs (Immutable Security Activity Trail)
// ==========================================
model AuditLog {
  id           String   @id @default(uuid()) @db.Uuid
  userId       String?  @map("user_id") @db.Uuid
  action       String   @db.VarChar(100) // e.g. AUTH_LOGIN, MFA_VERIFIED, VPN_CONNECT, POLICY_UPDATE
  metadataJson Json?    @map("metadata_json")
  ipAddress    String   @map("ip_address") @db.VarChar(45)
  createdAt    DateTime @default(now()) @map("created_at")

  user User? @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([userId])
  @@index([action])
  @@index([createdAt])
  @@map("audit_logs")
}

// ==========================================
// 8. Agent Versions (Client Installer Manifest)
// ==========================================
model AgentVersion {
  id             String   @id @default(uuid()) @db.Uuid
  versionString  String   @unique @map("version_string") @db.VarChar(30) // e.g. "1.0.0"
  downloadUrl    String   @map("download_url") @db.VarChar(500)
  checksumSha256 String   @map("checksum_sha256") @db.VarChar(64)
  isMandatory    Boolean  @default(false) @map("is_mandatory")
  releasedAt     DateTime @default(now()) @map("released_at")
  createdAt      DateTime @default(now()) @map("created_at")

  @@map("agent_versions")
}
