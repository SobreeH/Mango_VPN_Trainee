{
  "name": "mango-vpn",
  "version": "0.1.0",
  "private": true,
  "description": "Zero-Trust Role-Based WireGuard VPN Management System",
  "workspaces": [
    "Rain/*",
    "Sobree/*",
    "packages/*"
  ],
  "scripts": {
    "check:env": "node scripts/check-environment.mjs",
    "dev:api": "npm --workspace=@mango/api run dev",
    "dev:portal": "npm --workspace=@mango/portal run dev",
    "dev:portal:admin": "npm --workspace=@mango/portal run dev:admin",
    "dev:portal:staff": "npm --workspace=@mango/portal run dev:staff",
    "dev:portal:client": "npm --workspace=@mango/portal run dev:client",
    "dev:portal:all": "node scripts/start-all-portals.mjs",
    "dev:demo": "node scripts/dev-demo.mjs",
    "build": "npm --workspace=@mango/shared run build && npm run --workspaces --if-present build",
    "lint": "npm run --workspaces --if-present lint",
    "test": "npm run --workspaces --if-present test",
    "mock:agent": "node scripts/mock-agent.js",
    "mock:daemon": "node scripts/mock-daemon.js",
    "db:start": "node scripts/dev-db.mjs start",
    "db:reset-local": "node scripts/dev-db.mjs reset",
    "db:generate": "npm --workspace=@mango/api run prisma:generate",
    "db:migrate": "npm --workspace=@mango/api run prisma:migrate",
    "db:seed": "npm --workspace=@mango/rain-admin run seed",
    "docker:up": "docker compose up -d",
    "docker:down": "docker compose down",
    "docker:logs": "docker compose logs -f"
  },
  "devDependencies": {
    "embedded-postgres": "16.16.0-beta.19",
    "typescript": "^5.4.5"
  },
  "engines": {
    "node": ">=18.0.0"
  }
}
