server {
  listen ${TARGET_IP}:80;
  listen ${TARGET_IP}:443 ssl;
  server_name _;
  ssl_certificate /etc/nginx/certs/server.crt;
  ssl_certificate_key /etc/nginx/certs/server.key;
  gzip off;
  sub_filter_once off;
  sub_filter '__CLIENT_VPN_IP__' '$remote_addr';
  sub_filter '__SERVER_PORT__' '$server_port';
  sub_filter '__SCHEME__' '$scheme';
  sub_filter '__TIMESTAMP__' '$time_iso8601';
  location = /health.json {
    if ($request_method = OPTIONS) {
      add_header Access-Control-Allow-Origin "*" always;
      add_header Access-Control-Allow-Methods "GET, OPTIONS" always;
      add_header Access-Control-Allow-Headers "Content-Type, Access-Control-Request-Private-Network" always;
      add_header Access-Control-Allow-Private-Network "true" always;
      add_header Cache-Control "no-store" always;
      return 204;
    }
    add_header Access-Control-Allow-Origin "*" always;
    add_header Access-Control-Allow-Methods "GET, OPTIONS" always;
    add_header Access-Control-Allow-Headers "Content-Type, Access-Control-Request-Private-Network" always;
    add_header Access-Control-Allow-Private-Network "true" always;
    add_header Cache-Control "no-store" always;
    default_type application/json;
    return 200 '{"ok":true,"zone":"${ZONE_ID}","title":"${ZONE_TITLE}","targetIp":"${TARGET_IP}","clientVpnIp":"$remote_addr","port":"$server_port","scheme":"$scheme","timestamp":"$time_iso8601"}';
  }
  location / { root /usr/share/nginx/html; index index.html; try_files $uri $uri/ /index.html; }
}
