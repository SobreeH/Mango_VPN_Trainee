REFRESH_SECRET=
TOTP_ENCRYPTION_KEY=
DAEMON_SHARED_SECRET=
WG_INTERFACE=wg0
WG_LISTEN_PORT=51820
WG_GATEWAY_CIDR=10.13.13.1/24
WG_PRIVATE_KEY=
WG_SERVER_PUBLIC_KEY=
